# Copy this file to an untracked .env or source values manually before sbatch.
# Do not commit real API keys, VM hostnames, or private-key paths.

# Required: clients send this as `Authorization: Api-Key <value>`.
# Generate one with: openssl rand -hex 32
export POLICY_SERVER_API_KEYS="replace-with-a-long-random-key"

# Required: VM SSH login used for the reverse tunnel.
export TUNNEL_SSH_TARGET="deploy@policy-vm.example.com"

# Optional: SSH private key on the Yonsei cluster that can log into the VM.
export TUNNEL_SSH_KEY="${HOME}/.ssh/policy_tunnel"

# Caddy/nginx on the VM should proxy to 127.0.0.1:${TUNNEL_REMOTE_PORT}.
export TUNNEL_REMOTE_BIND="127.0.0.1"
export TUNNEL_REMOTE_PORT="18000"

# PoC defaults to the echo policy. For a real checkpoint, set POLICY_SPEC and
# POLICY_KWARGS, for example:
# export POLICY_SPEC="examples.my_policy:MyPolicy"
# export POLICY_KWARGS="checkpoint_path=/lustre/${USER}/checkpoints/policy.pt device=cuda:0"
export POLICY_SPEC="examples.echo_policy:EchoPolicy"

# Use one of these if needed by your Python environment.
# export CONDA_ENV="policy-deploy"
# export PYTHON_BIN="/home/${USER}/forwarding-test/.venv/bin/python"

export POLICY_PORT="8000"
export MAX_CONNECTIONS="4"
export MAX_MESSAGE_SIZE="33554432"
